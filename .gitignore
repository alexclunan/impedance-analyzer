# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local project settings
*.kicad_prl

.claude/          # ignore the .claude directory
.claude*          # or: ignore anything starting with .claude

.cursor/          # ignore the .claude directory
.cursor*          # or: ignore anything starting with .claude
.claude/settings.local.json

memory/
verification plans/

Vivado Project/*

*__pycache__/
*.py[cod]
